{
  "name": "weeklyscore",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev && yarn dev-server",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start-local-env": "node ./docker/index.js",
    "build-schema": "cd packages/schema && yarn build",
    "dev-server": "cd apps/backend && yarn dev",
    "dev-consumer": "cd apps/consumer && yarn dev"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
